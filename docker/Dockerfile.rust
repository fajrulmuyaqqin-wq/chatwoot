# Multi-Stage Production Dockerfile for Chatwoot Rust Backend
# Ultra-lightweight (~25-35 MB image vs 1.2 GB Rails image)
# Zero Redis, Zero Sidekiq, Zero Ruby dependencies

# ------------------------------------------------------------------------------
# Stage 1: Build static frontend assets (Vue 3 + Vite)
# ------------------------------------------------------------------------------
FROM node:20-bookworm-slim AS frontend-builder
WORKDIR /app
ARG PNPM_VERSION="10.2.0"
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build:sdk || true

# ------------------------------------------------------------------------------
# Stage 2: Compile Rust Release Binary
# ------------------------------------------------------------------------------
FROM rust:1.80-bookworm AS rust-builder
WORKDIR /app/backend
COPY backend/Cargo.toml backend/Cargo.lock ./
COPY backend/src ./src
COPY backend/migrations ./migrations
RUN cargo build --release --locked

# ------------------------------------------------------------------------------
# Stage 3: Minimal Production Runtime
# ------------------------------------------------------------------------------
FROM debian:bookworm-slim AS runner

# Install runtime essentials: TLS certificates, timezone data, and curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user 'chatwoot' for production security
RUN useradd -m -u 1001 -s /bin/bash chatwoot

WORKDIR /app

# Copy compiled Rust release binary
COPY --from=rust-builder /app/backend/target/release/chatwoot-backend /usr/local/bin/chatwoot-backend

# Copy SQL migrations
COPY --from=rust-builder /app/backend/migrations /app/migrations

# Copy static frontend assets
COPY --from=frontend-builder /app/public /app/public

# Setup local storage directory with non-root ownership
RUN mkdir -p /app/storage && chown -R chatwoot:chatwoot /app

USER chatwoot

# Production environment defaults
ENV PORT=3000
ENV HOST=0.0.0.0
ENV RUST_LOG=info
ENV PUBLIC_DIR=/app/public
ENV STORAGE_DIR=/app/storage

EXPOSE 3000

# Automated container healthcheck probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

ENTRYPOINT ["/usr/local/bin/chatwoot-backend"]
