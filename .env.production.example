# ==============================================================================
# Chatwoot Rust Backend - Production Environment Variables
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
FRONTEND_URL=https://chat.yourdomain.com
RUST_LOG=info

# PostgreSQL Database (PgVector supported)
DATABASE_URL=postgres://postgres:chatwoot_secure_pass_2026@postgres:5432/chatwoot_production
MAX_DB_CONNECTIONS=20

# Static & Upload Assets Storage
PUBLIC_DIR=/app/public
STORAGE_DIR=/app/storage

# Omnichannel Meta (WhatsApp Cloud API)
WHATSAPP_APP_SECRET=your_meta_whatsapp_app_secret
WHATSAPP_VERIFY_TOKEN=your_meta_wa_webhook_verify_token

# Omnichannel Meta (Instagram Direct Message)
INSTAGRAM_APP_SECRET=your_meta_instagram_app_secret
INSTAGRAM_VERIFY_TOKEN=your_meta_ig_webhook_verify_token

# Omnichannel Meta (Facebook Messenger)
FB_APP_SECRET=your_meta_facebook_app_secret
FB_VERIFY_TOKEN=your_meta_fb_webhook_verify_token

# Omnichannel Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Omnichannel Shopee Open Platform
SHOPEE_PARTNER_ID=your_shopee_partner_id
SHOPEE_PARTNER_KEY=your_shopee_partner_key

# Google Gemini AI (RAG & Reply Suggestions)
GEMINI_API_KEY=your_google_gemini_api_key
